# ─────────────────────────────────────────────────────────────────────────────
# Mithilesh Reddy × CSS — call booking. Copy to .env (local) or set in your host.
# Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL. Local: `docker compose up -d` gives you this URL.
DATABASE_URL="postgresql://css:css_local_only@localhost:5433/css_dev"

# Public URL of the site — used in emails and the ManyChat link. No trailing slash.
# Production example: https://book.mithileshreddy.com
APP_URL="http://localhost:3000"

# 32+ random characters. Signs reschedule/cancel links and hashes session tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=""

# ── Phone OTP ────────────────────────────────────────────────────────────────
# Resend does NOT send SMS. We use MSG91 (cheapest for Indian numbers).
# msg91 in production · mock for local development (codes show at /api/dev/outbox).
PHONE_VERIFY_PROVIDER="msg91"

# MSG91 OTP:
#   1. msg91.com → sign up → Settings → Auth Key  → MSG91_AUTH_KEY
#   2. Register on a DLT portal (Jio/Vodafone/Airtel) as the business ("Principal Entity"),
#      register a 6-letter sender header, and get an OTP SMS template approved, e.g.
#      "{#var#} is your verification code for mithilesh_lifts. It expires in 5 minutes."
#   3. In MSG91 → OTP → add the template (use ##OTP## for the code), paste the DLT IDs,
#      then copy the MSG91 template ID → MSG91_OTP_TEMPLATE_ID
MSG91_AUTH_KEY=""
MSG91_OTP_TEMPLATE_ID=""

# (Optional alternative, not used) Twilio Verify
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""

# Seconds before a visitor can request another code.
OTP_RESEND_COOLDOWN_SECONDS="45"

# ── Email (Resend) ───────────────────────────────────────────────────────────
# resend | mock (mock = local dev only)
EMAIL_PROVIDER="mock"
RESEND_API_KEY=""
# Sender on a domain verified in Resend (Domains → Add domain → add the DNS records).
EMAIL_FROM="mithilesh_lifts <calls@mail.yourdomain.com>"
EMAIL_REPLY_TO=""

# ── Jobs ─────────────────────────────────────────────────────────────────────
# Protects /api/cron/notifications (sends queued emails + reminders, retries failures).
# Vercel Cron sends it automatically as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=""

# ── Monitoring (optional) ────────────────────────────────────────────────────
SENTRY_DSN=""

# ── Payments (Razorpay) — quotes sent by the sales team are paid here ─────────
# dashboard.razorpay.com → Account & Settings → API Keys. Use rzp_test_ keys first.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Webhooks → add https://<APP_URL>/api/payments/razorpay/webhook (events: payment.captured, order.paid)
RAZORPAY_WEBHOOK_SECRET=""
